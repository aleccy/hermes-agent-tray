<Window x:Class="HermesAgentTray.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420" Height="380"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Language -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="LblLanguage" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbLanguage" Width="200" HorizontalAlignment="Left" FontSize="12">
                <ComboBoxItem Content="中文 (简体)" Tag="zh-CN"/>
                <ComboBoxItem Content="English" Tag="en-US"/>
            </ComboBox>
            <TextBlock x:Name="LblLanguageRestart" FontSize="10" Foreground="#95A5A6" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Auto Start App -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <CheckBox x:Name="ChkAutoStart" FontSize="13" Foreground="#2C3E50"/>
        </StackPanel>

        <!-- Auto Start Gateways -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <CheckBox x:Name="ChkAutoStartGateways" FontSize="13" Foreground="#2C3E50" Margin="0,0,0,4"/>
            <TextBlock x:Name="LblAutoStartGwHint" FontSize="10" Foreground="#95A5A6" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- About -->
        <Border Grid.Row="3" Background="White" CornerRadius="6" Padding="14" Margin="0,0,0,0"
                BorderThickness="1" BorderBrush="#D5D8DC">
            <StackPanel>
                <TextBlock x:Name="LblAbout" FontSize="13" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,8"/>
                <TextBlock Text="Hermes Agent Tray" FontSize="14" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,4"/>
                <TextBlock x:Name="LblVersion" FontSize="11" Foreground="#7F8C8D"/>
                <TextBlock x:Name="LblAuthor" FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                    Padding="16,5" Margin="0,0,8,0" Background="#BDC3C7" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click"
                    Padding="16,5" Background="#27AE60" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

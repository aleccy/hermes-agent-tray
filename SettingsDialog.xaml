<Window x:Class="HermesAgentTray.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="420" Height="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SettingsBackground}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Language -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="LblLanguage" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbLanguage" Width="200" HorizontalAlignment="Left" FontSize="12">
                <ComboBoxItem Content="中文 (简体)" Tag="zh-CN"/>
                <ComboBoxItem Content="English" Tag="en-US"/>
            </ComboBox>
            <TextBlock x:Name="LblLanguageRestart" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Theme -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock x:Name="LblTheme" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <ComboBox x:Name="CmbTheme" Width="200" HorizontalAlignment="Left" FontSize="12">
                <ComboBoxItem Content="跟随系统" Tag="System"/>
                <ComboBoxItem Content="浅色" Tag="Light"/>
                <ComboBoxItem Content="深色" Tag="Dark"/>
            </ComboBox>
        </StackPanel>

        <!-- Auto Start App -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <CheckBox x:Name="ChkAutoStart" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
        </StackPanel>

        <!-- Auto Start Gateways -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <CheckBox x:Name="ChkAutoStartGateways" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <TextBlock x:Name="LblAutoStartGwHint" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="20,0,0,0"/>
        </StackPanel>

        <!-- Auto Update -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <DockPanel>
                <CheckBox x:Name="ChkAutoUpdate" FontSize="13" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                <Button x:Name="BtnCheckUpdate" Click="BtnCheckUpdate_Click"
                        Padding="10,3" Margin="8,0,0,0" Background="{DynamicResource ButtonPrimary}" Foreground="{DynamicResource ButtonText}"
                        BorderThickness="0" FontSize="11" VerticalAlignment="Center"
                        Cursor="Hand"/>
            </DockPanel>
            <TextBlock x:Name="LblUpdateStatus" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="20,4,0,0" Visibility="Collapsed"/>
            <ProgressBar x:Name="ProgressDownload" Height="6" Margin="20,6,0,0"
                         Minimum="0" Maximum="100" Value="0"
                         Foreground="{DynamicResource ButtonPrimary}" Background="{DynamicResource CardBorder}"
                         Visibility="Collapsed"/>
        </StackPanel>

        <!-- About -->
        <Border Grid.Row="5" Background="{DynamicResource SettingsCardBackground}" CornerRadius="6" Padding="14" Margin="0,0,0,0"
                BorderThickness="1" BorderBrush="{DynamicResource SettingsCardBorder}">
            <StackPanel>
                <TextBlock x:Name="LblAbout" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                <TextBlock Text="Hermes Agent Tray" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextHeading}" Margin="0,0,0,4"/>
                <TextBlock x:Name="LblVersion" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                <TextBlock x:Name="LblAuthor" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Click="BtnCancel_Click"
                    Padding="16,5" Margin="0,0,8,0" Background="{DynamicResource CardBorder}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0"/>
            <Button x:Name="BtnSave" Content="Save" Click="BtnSave_Click"
                    Padding="16,5" Background="{DynamicResource ButtonStart}" Foreground="{DynamicResource ButtonText}" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>

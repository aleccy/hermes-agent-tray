<Window x:Class="HermesAgentTray.ProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile Configuration"
        Width="560" Height="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Profile Name -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="LblProfileName" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="#2C3E50"/>
            <TextBox x:Name="TxtProfileName" FontSize="14" Padding="8,6"
                     BorderThickness="1" BorderBrush="#DDD"/>
            <TextBlock x:Name="TxtNameHint" FontSize="11" Foreground="#7F8C8D" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Quick Actions -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnLoadEnv" Click="BtnLoadEnv_Click"
                    Padding="10,4" FontSize="11" Margin="0,0,8,0"/>
        </StackPanel>

        <!-- Environment Variables -->
        <Border Grid.Row="2" Background="White" CornerRadius="6" Padding="12"
                BorderThickness="1" BorderBrush="#DDD">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="LblEnvVars" Grid.Row="0" FontWeight="SemiBold"
                           Foreground="#2C3E50" Margin="0,0,0,8"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EnvPanel"/>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="BtnAddVar" Click="BtnAddVar_Click"
                    Padding="12,6" Margin="0,0,8,0" FontSize="12"/>
            <Button x:Name="BtnOk" Click="BtnOk_Click" IsDefault="True"
                    Padding="24,6" Margin="0,0,8,0" FontSize="12"
                    Background="#4A90D9" Foreground="White" BorderThickness="0"/>
            <Button x:Name="BtnCancelDlg" Click="BtnCancel_Click" IsCancel="True"
                    Padding="24,6" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>

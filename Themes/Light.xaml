<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors (default) -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="CardBackground" Color="White"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="PanelBorder" Color="#D5D8DC"/>
    <SolidColorBrush x:Key="StatusBarBorder" Color="#DDD"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="TextMuted" Color="#95A5A6"/>
    <SolidColorBrush x:Key="TextHeading" Color="#34495E"/>
    <SolidColorBrush x:Key="TextSection" Color="#5D6D7E"/>
    <SolidColorBrush x:Key="StatusRunning" Color="#27AE60"/>
    <SolidColorBrush x:Key="StatusStopped" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="StatusStarting" Color="#F39C12"/>
    <SolidColorBrush x:Key="StatusError" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ButtonStart" Color="#27AE60"/>
    <SolidColorBrush x:Key="ButtonStop" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ButtonPrimary" Color="#4A90D9"/>
    <SolidColorBrush x:Key="ButtonConfig" Color="#8E44AD"/>
    <SolidColorBrush x:Key="ButtonText" Color="White"/>
    <SolidColorBrush x:Key="CardRunningBorder" Color="#27AE60"/>
    <SolidColorBrush x:Key="CheckboxDisabled" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="White"/>
    <SolidColorBrush x:Key="StatusBarText" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="SettingsBackground" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="SettingsCardBackground" Color="White"/>
    <SolidColorBrush x:Key="SettingsCardBorder" Color="#D5D8DC"/>
</ResourceDictionary>
